# === LLM Provider 配置 ===
# 当前实现基于 OpenAI SDK + base_url
# 推荐使用任何 OpenAI-compatible 云 API，例如:
# - deepseek
# - openai
# - openrouter
# - siliconflow

# Ollama 仅作为可选本地方案
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here

# 其他云 API 示例:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...

# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...

# 如果用 Docker 跑 Agent、Ollama 跑在宿主机，请改成：
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# === Obsidian Vault 路径 ===
# 相对于 Python_Agent/ 目录，或使用绝对路径
VAULT_PATH=../Obsidian_Vault

# === Embedding 模型 ===
EMBEDDING_MODEL=BAAI/bge-m3

# === Map-Reduce 分块大小 (粗估 token 数) ===
MAX_CHUNK_TOKENS=6000

# === 文件监听后端 ===
# 本地直接运行建议使用 native
# Docker 挂载宿主机目录时建议使用 polling
OBSERVER_BACKEND=native

# === 健康检查心跳 ===
HEARTBEAT_INTERVAL_SECONDS=15
HEALTHCHECK_STALE_SECONDS=120
